{
  "name": "docker-ci-api",
  "version": "1.0.0",
  "private": true,
  "description": "Containerized Node.js API for Docker build CI lab",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "lint": "node --check src/server.js && node --check test/server.test.js",
    "test": "node --test",
    "ci:local": "npm run lint && npm test"
  }
}